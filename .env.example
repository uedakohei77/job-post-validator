# Gemini API configuration
GEMINI_API_KEY=your_gemini_api_key_here

# Slack OAuth App Credentials
SLACK_CLIENT_ID=your_slack_client_id_here
SLACK_CLIENT_SECRET=your_slack_client_secret_here

# Slack Channel configuration
SLACK_CHANNEL_ID=C0123456789

# Port for local OAuth redirect receiver (must match your Slack App's Redirect URI, e.g. http://localhost:8080/)
SLACK_PORT=8080

# Category suggestion module (optional): channels to scan for past postings, comma-separated.
# Defaults to SLACK_CHANNEL_ID. Include last school year's channel to cover the whole period.
# CATEGORY_CHANNEL_IDS=C0123456789,C08JG3E4LUF
# Fetch postings from this date (YYYY-MM-DD) up to the time of the run. Default: 2025-01-01
# CATEGORY_START_DATE=2025-01-01
